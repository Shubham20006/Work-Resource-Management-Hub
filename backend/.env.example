# Port to run the server on (Render sets PORT automatically)
PORT=5000

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017/sheet_manager)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sheet_manager?retryWrites=true&w=majority

# Client URLs for CORS (comma separated if multiple)
CLIENT_URL=http://localhost:5173,https://your-frontend-domain.onrender.com

# Environment mode (development / production)
NODE_ENV=development

# JWT Secret key for authentication
JWT_SECRET=your_jwt_secret_key_here

